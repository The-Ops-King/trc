# Copy to .env.local for local development. In Vercel, add these under
# Settings -> Environment Variables (mark secrets as Sensitive).

# Required
DASHBOARD_PASSWORD=          # shared login password
CRON_SECRET=                 # any long random string; Vercel Cron sends it automatically
POSTGRES_URL=                # added by the Supabase integration
POSTGRES_URL_NON_POOLING=    # added by the Supabase integration (used for migrations)

# HighLevel (required)
GHL_PIT=                     # Private Integration Token, read-only scopes
GHL_LOCATION=                # location ID

# Whop (required)
WHOP_API_KEY=

# Meta Ads (optional - metrics 1-3 switch on when set)
META_ACCESS_TOKEN=           # System User token with ads_read
META_AD_ACCOUNT_ID=          # act_123... or just the number
META_CAMPAIGN_FILTER=        # optional regex; only matching campaign names count (e.g. standout)
META_API_VERSION=            # optional, defaults to v24.0

# Zoom (optional - metrics 4, 5, 8 and onboarding attendance switch on when set)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Slack (optional - daily report after the morning sync)
SLACK_WEBHOOK_URL=
DASHBOARD_URL=https://trc.jtylerray.com
